<IfModule mod_rewrite.c>
  RewriteEngine On
  # IMPORTANT:
  # - Ne pas forcer RewriteBase ici: si l'app est servie dans un sous-dossier,
  #   un RewriteBase '/' peut casser des chemins (images/models) et des rewrites.

  # Ne JAMAIS réécrire les appels API vers index.html.
  # Si un backend est proxy (ou si /api n'existe pas), on veut une vraie réponse API (ou 404), pas du HTML.
  RewriteRule ^api(/|$) - [L]

  # Laisser passer les fichiers et dossiers existants (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: tout le reste vers index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Types MIME explicites
AddType application/javascript .js .mjs
AddType text/css .css
AddType application/wasm .wasm
AddType model/gltf-binary .glb
AddType image/vnd.radiance .hdr
AddType application/json .json

<IfModule mod_headers.c>
  # Cache long uniquement pour les fichiers fingerprintés (JS/CSS/wasm).
  # Les images/models dans /images et /models ne sont pas fingerprintés: éviter 'immutable'
  # pour ne pas rester bloqué sur d'anciens fichiers après un redeploy.
  <FilesMatch "\.(js|mjs|css|wasm)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>

  <FilesMatch "\.(glb|hdr|png|jpg|jpeg|gif|svg|ico|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
