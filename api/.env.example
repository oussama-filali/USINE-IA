# Configuration Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-publique

# (Backend only) Service Role key (needed to read subscribers for sending emails)
# ⚠️ Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# Port du serveur
PORT=3001

# Brevo (Sendinblue) - Automations (welcome email)
# IMPORTANT: SMTP only sends emails; it does NOT add contacts or trigger automations.
# To trigger a Brevo automation, you typically need to add a contact to a list.
BREVO_API_KEY=votre_cle_api_brevo
BREVO_LIST_ID=123

# SMTP (email sending)
# Example providers: Brevo (Sendinblue), Mailjet, SendGrid...
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_smtp_user
SMTP_PASS=votre_smtp_pass

MAIL_FROM_EMAIL=no-reply@votre-domaine.com
MAIL_FROM_NAME=USINE-IA

# Digest behavior
DIGEST_TAG=ai
DIGEST_ARTICLES_LIMIT=5
DIGEST_SUBJECT=[USINE-IA] Digest IA du jour
DIGEST_BCC_BATCH_SIZE=50

# Safety switches
DRY_RUN=true
